# Condense ENV Variables — Aerospace Reference Data (Custom Input Connector)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_MACHINE_MASTER=aerospace-machine-master-cdc
KAFKA_TOPIC_PROCESS_MASTER=aerospace-process-master-cdc
# Re-publish the full master data this often so the Enrich Utility cache is warm
# even if the utility (re)starts after this connector.
REPUBLISH_INTERVAL_S=60
PORT=3002
# Publish CDC-envelope messages {before, after, op, ts_ms} (required by the Enrich Utility's CDC step)
CDC_ENVELOPE=true
# Set true only if the platform wants before/after as JSON strings instead of objects
CDC_PAYLOAD_AS_STRING=false
